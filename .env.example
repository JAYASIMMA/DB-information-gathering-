# PostgreSQL source clusters. Use either a complete URL or the component variables below.
# Keep this file secret; do not put real credentials in source control.
DEV_DATABASE_URL=postgresql://<user>:<password>@<dev-host>:5432/postgres
UAT_DATABASE_URL=postgresql://<user>:<password>@<uat-host>:5432/postgres

# Component form (used when the corresponding *_DATABASE_URL is empty)
DEV_DB_HOST=
DEV_DB_PORT=5432
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_DB_ADMIN_DATABASE=postgres

UAT_DB_HOST=
UAT_DB_PORT=5432
UAT_DB_USER=
UAT_DB_PASSWORD=
UAT_DB_ADMIN_DATABASE=postgres

# Central PostgreSQL warehouse receiving the audit snapshots.
STORAGE_DATABASE_URL=postgresql://<user>:<password>@<storage-host>:5432/e34data78
# Alternatively use STORAGE_DB_HOST, STORAGE_DB_PORT, STORAGE_DB_USER,
# STORAGE_DB_PASSWORD, and TARGET_STORAGE_DB.
STORAGE_DB_HOST=
STORAGE_DB_PORT=5432
STORAGE_DB_USER=
STORAGE_DB_PASSWORD=
TARGET_STORAGE_DB=e34data78

# Optional AWS settings used by the other inspection tools in this repository.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DB_INSTANCE_IDENTIFIER=
DB_ENGINE=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
