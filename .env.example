# Full Database Connection String (Directly supported by inspector)
DATABASE_URL=
# AWS Configuration (for OS patches, maintenance actions, and VPC Security Groups)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS RDS / Aurora Target Identifier (Optional if DATABASE_URL is set)
DB_INSTANCE_IDENTIFIER=

# Individual DB Connection Parameters (Fallback if DATABASE_URL is not used)
DB_ENGINE=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
